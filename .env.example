# --- Database (Neon) ---------------------------------------------------------
# Use the POOLED connection string from the Neon dashboard (host contains "-pooler").
DATABASE_URL=

# --- Payload -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Public site URL (no trailing slash) --------------------------------------
NEXT_PUBLIC_SITE_URL=https://sultanipinmisho.tech

# --- Media storage (Vercel Blob) ------------------------------------------------
# Create a Blob store in Vercel (Storage tab). The token is added automatically when you connect it.
BLOB_READ_WRITE_TOKEN=

# --- Contact form email notifications (optional) --------------------------------
# Messages are ALWAYS saved in the CMS. If you also want an email, add a Resend key.
RESEND_API_KEY=
CONTACT_TO_EMAIL= 
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
